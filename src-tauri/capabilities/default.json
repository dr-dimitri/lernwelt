{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main-window",
  "description": "Lokales Hauptfenster mit signierten App-Updates; ohne freien Datei-, Shell- oder Netzwerkzugriff.",
  "windows": ["main"],
  "permissions": [
    "core:app:allow-version",
    "core:resources:allow-close",
    "updater:allow-check",
    "updater:allow-download-and-install",
    "process:allow-restart",
    "allow-get-profile",
    "allow-save-profile",
    "allow-list-progress",
    "allow-get-learning-state",
    "allow-set-difficulty",
    "allow-submit-answer",
    "allow-redeem-reward",
    "allow-get-arcade-state",
    "allow-start-game",
    "allow-finish-game",
    "allow-get-vocabulary-state",
    "allow-review-vocabulary",
    "allow-get-multiplication-state",
    "allow-answer-multiplication",
    "allow-configure-multiplication",
    "allow-get-mission-state",
    "allow-start-mission",
    "allow-act-mission"
  ]
}
