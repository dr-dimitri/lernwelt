{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main-window",
  "description": "Lokales Hauptfenster ohne Dateisystem-, Shell- oder Netzwerk-Plugins.",
  "windows": ["main"],
  "permissions": [
    "allow-get-profile",
    "allow-save-profile",
    "allow-list-progress",
    "allow-get-learning-state",
    "allow-set-difficulty",
    "allow-submit-answer",
    "allow-redeem-reward",
    "allow-get-arcade-state",
    "allow-start-game",
    "allow-finish-game",
    "allow-get-vocabulary-state",
    "allow-review-vocabulary",
    "allow-get-multiplication-state",
    "allow-answer-multiplication"
  ]
}
